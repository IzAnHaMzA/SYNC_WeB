# INSTOK Enhanced Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# BASIC CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# 2FA Configuration
TOTP_ISSUER=INSTOK
TOTP_ALGORITHM=sha256
TOTP_DIGITS=6
TOTP_PERIOD=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
# File Upload Limits
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# Storage Configuration
UPLOAD_PATH=./uploads
CDN_URL=https://your-cdn-domain.com

# ===========================================
# THIRD-PARTY INTEGRATIONS
# ===========================================
# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SMS Service (for 2FA)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# ===========================================
# MONITORING & LOGGING
# ===========================================
# Error Tracking
SENTRY_DSN=your_sentry_dsn_here

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# ===========================================
# WEBSOCKET CONFIGURATION
# ===========================================
# WebSocket Settings
WS_PORT=5001
WS_CORS_ORIGIN=http://localhost:3000

# ===========================================
# CACHE CONFIGURATION
# ===========================================
# Cache TTL (Time To Live) in seconds
CACHE_TTL_USER=3600
CACHE_TTL_POST=1800
CACHE_TTL_FEED=300
CACHE_TTL_COMMENTS=900

# ===========================================
# CONTENT MODERATION
# ===========================================
# AI Content Moderation
OPENAI_API_KEY=your_openai_api_key
MODERATION_ENABLED=true

# Image Recognition
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ===========================================
# SOCIAL FEATURES
# ===========================================
# Social Login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ===========================================
# PUSH NOTIFICATIONS
# ===========================================
# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ===========================================
# CDN & ASSET OPTIMIZATION
# ===========================================
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# CloudFront Configuration
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id
CLOUDFRONT_DOMAIN=your_cloudfront_domain

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
# Debug Configuration
DEBUG=instok:*
VERBOSE_LOGGING=true

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/instok_test

# ===========================================
# PRODUCTION OPTIMIZATION
# ===========================================
# Performance
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_CDN=true

# Security
ENABLE_HTTPS=true
ENABLE_CSP=true
ENABLE_HSTS=true

# ===========================================
# FEATURE FLAGS
# ===========================================
# Feature Toggles
ENABLE_2FA=true
ENABLE_REAL_TIME=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=true
ENABLE_LIVE_STREAMING=false
ENABLE_AI_RECOMMENDATIONS=false

# ===========================================
# API CONFIGURATION
# ===========================================
# API Versioning
API_VERSION=v1
API_PREFIX=/api

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
CORS_CREDENTIALS=true

# ===========================================
# MOBILE APP CONFIGURATION
# ===========================================
# React Native
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
REACT_NATIVE_PACKAGER_PORT=8081

# App Store Configuration
APPLE_APP_ID=your_apple_app_id
GOOGLE_PLAY_APP_ID=your_google_play_app_id

# ===========================================
# BACKUP & RECOVERY
# ===========================================
# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===========================================
# COMPLIANCE & LEGAL
# ===========================================
# GDPR Compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365

# Terms of Service
TERMS_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0

# ===========================================
# CUSTOM CONFIGURATION
# ===========================================
# Add your custom environment variables here
# CUSTOM_VARIABLE=your_custom_value
